# BasicNscCniFlow

main: kit: flow: BasicNscCniFlow:
{
  entity: "nsc_cni",
  kind: "basic",
  name: "BasicNscCniFlow",
  step: [
    {
      i: {
        ref: "nsc_cni_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "nsc_cni_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "nsc_cni_ref01",
        srcdatavar: "nsc_cni_ref01_data",
        suffix: "_up0",
        textfield: "account"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-nsc_cni_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "nsc_cni_ref01",
        srcdatavar: "nsc_cni_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "nsc_cni01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-nsc_cni_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicNscCniFlow"
}