# BasicDeploymentGroupFlow

main: kit: flow: BasicDeploymentGroupFlow:
{
  entity: "deployment_group",
  kind: "basic",
  name: "BasicDeploymentGroupFlow",
  step: [
    {
      i: {
        ref: "deployment_group_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "deployment_group_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "deployment_group_ref01",
        srcdatavar: "deployment_group_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-deployment_group_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "deployment_group_ref01",
        srcdatavar: "deployment_group_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "deployment_group01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-deployment_group_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "deployment_group_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "deployment_group01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "deployment_group_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDeploymentGroupFlow"
}