# BasicPhysicalDeviceFlow

main: kit: flow: BasicPhysicalDeviceFlow:
{
  entity: "physical_device",
  kind: "basic",
  name: "BasicPhysicalDeviceFlow",
  step: [
    {
      i: {
        ref: "physical_device_ref01"
      }

      m: {
        account_id: "account01",
        device_id: "device01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "physical_device_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "physical_device_ref01",
        srcdatavar: "physical_device_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-physical_device_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "physical_device_ref01",
        srcdatavar: "physical_device_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "physical_device01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-physical_device_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "physical_device_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "physical_device01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "physical_device_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPhysicalDeviceFlow"
}