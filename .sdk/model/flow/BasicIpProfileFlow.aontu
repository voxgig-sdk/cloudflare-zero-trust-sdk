# BasicIpProfileFlow

main: kit: flow: BasicIpProfileFlow:
{
  entity: "ip_profile",
  kind: "basic",
  name: "BasicIpProfileFlow",
  step: [
    {
      i: {
        ref: "ip_profile_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "ip_profile_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "ip_profile_ref01",
        srcdatavar: "ip_profile_ref01_data",
        suffix: "_up0",
        textfield: "description"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ip_profile_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ip_profile_ref01",
        srcdatavar: "ip_profile_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "ip_profile01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ip_profile_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ip_profile_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "ip_profile01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "ip_profile_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIpProfileFlow"
}