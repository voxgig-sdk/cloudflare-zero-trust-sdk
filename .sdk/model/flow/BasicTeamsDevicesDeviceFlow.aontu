# BasicTeamsDevicesDeviceFlow

main: kit: flow: BasicTeamsDevicesDeviceFlow:
{
  entity: "teams_devices_device",
  kind: "basic",
  name: "BasicTeamsDevicesDeviceFlow",
  step: [
    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "teams_devices_device_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "teams_devices_device_ref01",
        srcdatavar: "teams_devices_device_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "teams_devices_device01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-teams_devices_device_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTeamsDevicesDeviceFlow"
}