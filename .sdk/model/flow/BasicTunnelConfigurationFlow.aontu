# BasicTunnelConfigurationFlow

main: kit: flow: BasicTunnelConfigurationFlow:
{
  entity: "tunnel_configuration",
  kind: "basic",
  name: "BasicTunnelConfigurationFlow",
  step: [
    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "tunnel_configuration_ref01",
        srcdatavar: "tunnel_configuration_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tunnel_configuration_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tunnel_configuration_ref01",
        srcdatavar: "tunnel_configuration_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "tunnel_configuration01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tunnel_configuration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTunnelConfigurationFlow"
}