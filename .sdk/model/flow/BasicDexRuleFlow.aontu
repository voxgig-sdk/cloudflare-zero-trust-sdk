# BasicDexRuleFlow

main: kit: flow: BasicDexRuleFlow:
{
  entity: "dex_rule",
  kind: "basic",
  name: "BasicDexRuleFlow",
  step: [
    {
      i: {
        ref: "dex_rule_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "dex_rule_ref01",
        srcdatavar: "dex_rule_ref01_data",
        suffix: "_up0",
        textfield: "description"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-dex_rule_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "dex_rule_ref01",
        srcdatavar: "dex_rule_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "dex_rule01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-dex_rule_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "dex_rule_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "dex_rule01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicDexRuleFlow"
}