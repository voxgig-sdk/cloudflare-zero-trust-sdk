            {
              lit: "dex"
            }
            {
              lit: "devices"
            }
            {
              var: "device_id"
            }
            {
              lit: "fleet-status"
            }
            {
              lit: "live"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
