          co: {
            id: "GET /accounts/{account_id}/dex/devices/{device_id}/fleet-status/live"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01a7362d577a6c3019a474fd6f485823"
                k: "param"
                n: "account_id"
